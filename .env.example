# JWT secret for backend (HS256). Must be at least 32 bytes (256 bits).
# Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -join ' ')
#   Linux/macOS: openssl rand -base64 32
JWT_SECRET=please-change-this-to-a-real-32-byte-secret-min

# AES master key for encrypting OAuth tokens at rest (calendar integrations).
# REQUIRED if you use calendar sync — backend fails to start without it.
# Same format as JWT_SECRET: must decode to 32 bytes (256 bits) once hashed.
# We hash this with SHA-256 to derive the AES-256 key, so any length works.
ENCRYPTION_KEY=change-this-to-a-real-master-key-base64

# Optional: change if you customize ports
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=80

# ─────────────────────────────────────────────────────────
# Calendar sync (Fase 14) — optional. Without these, calendar sync endpoints
# return 503 "provider_not_configured". MVP still works without them.
# To enable Google Calendar sync, register an OAuth 2.0 client in Google Cloud
# Console (https://console.cloud.google.com) and paste credentials below.
# Authorized redirect URI must be:
#   http://localhost:8080/api/calendar/integrations/google/callback   (dev)
#   https://your-prod-host/api/calendar/integrations/google/callback      (prod)
#GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-client-secret

# ─────────────────────────────────────────────────────────
# Vonage WhatsApp sandbox
# Credentials from: https://www.vonage.com/communications-apis/messaging/
# Free tier: 100 messages/month, webhook configurable without upgrade.
# VONAGE_API_KEY=your-api-key
# VONAGE_API_SECRET=your-api-secret
# VONAGE_SANDBOX_NUMBER=your-sandbox-number
